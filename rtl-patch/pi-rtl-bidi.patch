diff --git a/packages/tui/test/bidi-components.test.ts b/packages/tui/test/bidi-components.test.ts
new file mode 100644
index 000000000..44c4f0f66
--- /dev/null
+++ b/packages/tui/test/bidi-components.test.ts
@@ -0,0 +1,91 @@
+import assert from "node:assert";
+import { describe, it } from "node:test";
+import { configureBidi, reorderLine } from "../src/bidi.ts";
+import { Input } from "../src/components/input.ts";
+import { ScrollView } from "../src/components/scroll-view.ts";
+import { SelectList } from "../src/components/select-list.ts";
+import { SettingsList, type SettingsListTheme } from "../src/components/settings-list.ts";
+import { Text } from "../src/components/text.ts";
+import { visibleWidth } from "../src/utils.ts";
+
+const stripAnsi = (line: string): string =>
+	line
+		.replace(/\x1b\[[0-9;]*m/g, "")
+		.replace(/\x1b\][^\x07]*(?:\x07|\x1b\\)/g, "")
+		// The fake cursor and the hardware cursor marker are layout, not text.
+		.replace(/\x1b_pi:[\s\S]*?\x07/g, "")
+		.trimEnd();
+
+const listTheme = {
+	selectedPrefix: (text: string) => text,
+	selectedText: (text: string) => text,
+	description: (text: string) => text,
+	scrollInfo: (text: string) => text,
+	noMatch: (text: string) => text,
+};
+
+const settingsTheme: SettingsListTheme = {
+	label: (text) => text,
+	value: (text) => text,
+	description: (text) => text,
+	cursor: "> ",
+	hint: (text) => text,
+};
+
+describe("RTL in components that build their own lines", () => {
+	it("paints a single-line input in visual order", () => {
+		const input = new Input({ prompt: "" });
+		input.handleInput("مرحبا");
+		const line = stripAnsi(input.render(20)[0]);
+		assert.equal(line, reorderLine("مرحبا"), line);
+		assert.ok(visibleWidth(line) <= 20, line);
+	});
+
+	it("leaves an English input untouched", () => {
+		const input = new Input({ prompt: "" });
+		input.handleInput("hello world");
+		assert.equal(stripAnsi(input.render(20)[0]), "hello world");
+	});
+
+	it("paints an Arabic row of a select list", () => {
+		const list = new SelectList([{ value: "مرحبا", label: "مرحبا" }], 5, listTheme);
+		const line = stripAnsi(list.render(20)[0]);
+		assert.ok(line.includes(reorderLine("مرحبا")), line);
+	});
+
+	it("paints Arabic labels and values inside their columns", () => {
+		const list = new SettingsList(
+			[{ id: "rtl", label: "مرحبا", currentValue: "نعم", values: ["نعم", "لا"] }],
+			10,
+			settingsTheme,
+			() => {},
+			() => {},
+		);
+		const line = stripAnsi(list.render(40)[0]);
+		assert.ok(line.includes(reorderLine("مرحبا")), line);
+		assert.ok(line.includes(reorderLine("نعم")), line);
+		assert.ok(visibleWidth(line) <= 40, line);
+	});
+
+	it("puts the scrollbar gutter on the edge the line reads from", () => {
+		configureBidi({ enabled: true, align: true });
+		try {
+			const rtl = new ScrollView(new Text("مرحبا", 0, 0), { scrollbar: "always" }).render(10)[0];
+			const ltr = new ScrollView(new Text("hello", 0, 0), { scrollbar: "always" }).render(10)[0];
+			assert.ok(rtl.startsWith(" "), rtl);
+			assert.ok(ltr.endsWith(" "), ltr);
+		} finally {
+			configureBidi({ enabled: true, align: false });
+		}
+	});
+
+	it("repaints a cached line when the bidi settings change", () => {
+		configureBidi({ enabled: true, align: true });
+		const text = new Text("مرحبا", 1, 0);
+		const aligned = text.render(10)[0];
+		configureBidi({ enabled: true, align: false });
+		const unaligned = text.render(10)[0];
+		assert.notEqual(aligned, unaligned, "a settings change must repaint the cached line");
+		configureBidi({ enabled: true, align: false });
+	});
+});
diff --git a/packages/tui/test/bidi-editor.test.ts b/packages/tui/test/bidi-editor.test.ts
new file mode 100644
index 000000000..4904667c4
--- /dev/null
+++ b/packages/tui/test/bidi-editor.test.ts
@@ -0,0 +1,244 @@
+import assert from "node:assert";
+import { describe, it } from "node:test";
+import { caretOffsetAtVisualColumn, configureBidi } from "../src/bidi.ts";
+import { Editor } from "../src/components/editor.ts";
+import type { TUI } from "../src/tui.ts";
+import { FAKE_CURSOR_START } from "../src/tui.ts";
+import { TuiMainScreen } from "../src/tui-main-screen.ts";
+import { visibleWidth } from "../src/utils.ts";
+import { defaultEditorTheme } from "./test-themes.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+function createTestTUI(cols = 80, rows = 24): TUI {
+	return new TuiMainScreen(new VirtualTerminal(cols, rows));
+}
+
+// The editor keeps its buffer and caret in a private state; tests read it directly.
+function editorState(editor: Editor): { lines: string[]; cursorCol: number; cursorLine: number } {
+	return (editor as unknown as { state: { lines: string[]; cursorCol: number; cursorLine: number } }).state;
+}
+
+function typeInto(editor: Editor, text: string): void {
+	for (const char of text) editor.handleInput(char);
+}
+
+function click(editor: Editor, x: number, y: number, width: number): void {
+	editor.handleMouse({
+		type: "click",
+		button: "left",
+		x,
+		y,
+		width,
+		height: 24,
+		screenX: x,
+		screenY: y,
+		shift: false,
+		alt: false,
+		ctrl: false,
+	});
+}
+
+/** Column the fake cursor occupies in the rendered line, i.e. where the caret shows up. */
+function caretColumn(editor: Editor, width: number, row = 1): number {
+	const line = editor.render(width)[row]!;
+	const index = line.indexOf(FAKE_CURSOR_START);
+	return index < 0 ? -1 : visibleWidth(line.slice(0, index));
+}
+
+describe("RTL in the editor", () => {
+	it("paints an RTL line in visual order while keeping the logical string", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "مرحبا");
+
+		assert.strictEqual(editorState(editor).lines[0], "مرحبا", "stored text stays logical");
+		const content = editor.render(40)[1]!;
+		assert.ok(content.includes("ا"), "visual line starts with the last logical grapheme");
+		assert.ok(visibleWidth(content) <= 40, "painted line does not change width");
+	});
+
+	it("keeps English lines byte for byte", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "hello world");
+		assert.deepStrictEqual(editor.render(40), editor.render(40));
+		const line = editor.render(40)[1]!;
+		assert.ok(line.includes("hello world"), "LTR line is not reordered");
+	});
+
+	it("moves the caret visually, not logically, on arrow keys", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "مرحبا");
+		// Logical caret is at the end (index 5), which is the left edge visually.
+		assert.strictEqual(editorState(editor).cursorCol, 5);
+
+		// Right arrow goes right on screen = one grapheme earlier in the string.
+		editor.handleInput("\x1b[C");
+		assert.strictEqual(editorState(editor).cursorCol, 4, "right arrow steps backwards through RTL text");
+
+		// Pressing Left at the logical end (already the visual left edge) does nothing.
+		for (let i = 0; i < 5; i++) editor.handleInput("\x1b[D");
+		assert.strictEqual(editorState(editor).cursorCol, 5, "caret stops at the visual left edge");
+
+		// Right walks back through the run one grapheme at a time.
+		for (let i = 0; i < 5; i++) editor.handleInput("\x1b[C");
+		assert.strictEqual(editorState(editor).cursorCol, 0, "right arrow reaches the logical start");
+		editor.handleInput("\x1b[C");
+		assert.strictEqual(editorState(editor).cursorCol, 0, "caret does not jump past the visual right edge");
+	});
+
+	it("places the painted caret on the visual side of the grapheme it precedes", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "مرحبا");
+		const line = editor.render(40)[1]!;
+
+		// Caret is at the logical end, so it must appear at the left of the RTL run,
+		// not at the right where the logical index would put it.
+		const cursorColumn = line.indexOf(FAKE_CURSOR_START);
+		const textStart = line.search(/[ء-ي]/);
+		assert.ok(
+			cursorColumn >= 0 && cursorColumn <= textStart,
+			`caret at column ${cursorColumn}, run starts at ${textStart}`,
+		);
+	});
+
+	it("keeps the caret on the visual edge when the RTL line is right-aligned", () => {
+		configureBidi({ enabled: true, align: true });
+		try {
+			const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+			typeInto(editor, "مرحبا");
+			const line = editor.render(40)[1]!;
+
+			// The run hugs the right edge of the column and the caret still sits at the
+			// left of it, where an RTL reader expects the next character to go.
+			assert.equal(visibleWidth(line), 40, line);
+			const cursorColumn = line.indexOf(FAKE_CURSOR_START);
+			const textStart = line.search(/[ء-ي]/);
+			assert.ok(textStart > 0, `run starts at column ${textStart}`);
+			assert.ok(cursorColumn >= 0 && cursorColumn <= textStart, `caret at ${cursorColumn}, run at ${textStart}`);
+			assert.ok(visibleWidth(line) === 40, line);
+		} finally {
+			configureBidi({ enabled: true, align: false });
+		}
+	});
+
+	it("draws the caret at the left edge of an RTL line, where the text ends", async () => {
+		const terminal = new VirtualTerminal(40, 8);
+		const editor = new Editor(new TuiMainScreen(terminal), defaultEditorTheme);
+		typeInto(editor, "مرحبا\nعالم");
+		for (const line of editor.render(40)) terminal.write(`${line}\n`);
+		const line = editor.render(40)[1]!;
+		// Drop the styling and cursor-marker escapes, keep the painted graphemes.
+		const painted = line
+			.replace(/\x1b[^\x07]*\x07/g, "")
+			.replace(/\x1b\[[0-9;]*m/g, "")
+			.trimEnd();
+		// The caret sits at the logical end, which in RTL is the left edge of the line.
+		assert.ok(painted.startsWith("ا"), painted);
+		assert.ok(painted.indexOf("ا") < painted.indexOf("ب"), painted);
+	});
+
+	it("keeps the caret at the reading end when a space follows an RTL word", () => {
+		configureBidi({ enabled: true, align: true });
+		try {
+			const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+			typeInto(editor, "مرحبا");
+			const before = caretColumn(editor, 40);
+			editor.handleInput(" ");
+			const after = caretColumn(editor, 40);
+			// The space joins the padding at the physical end of the line; the caret must
+			// not ride it to the far edge, it stays against the text it follows.
+			assert.ok(after < before, `caret jumped to column ${after} after a space`);
+			assert.equal(visibleWidth(editor.render(40)[1]!), 40, editor.render(40)[1]);
+		} finally {
+			configureBidi({ enabled: true, align: false });
+		}
+	});
+
+	it("inserts at the caret position when typing in the middle of an RTL line", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "مرحبا");
+		editor.handleInput("\x1b[C"); // visual right = logical position 4
+		editor.handleInput("X");
+		assert.strictEqual(editorState(editor).lines[0], "مرحبXا", "typing lands at the logical caret");
+	});
+
+	it("puts the caret on the character the mouse is clicked on", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "مرحبا");
+
+		// Painted left to right: ا ب ح ر م. Each click has to land on the grapheme
+		// under the pointer, not on its mirror position.
+		const expected = [5, 4, 3, 2, 1];
+		for (let column = 0; column < expected.length; column++) {
+			click(editor, column, 1, 40);
+			assert.strictEqual(editorState(editor).cursorCol, expected[column], `click on column ${column}`);
+			assert.strictEqual(caretColumn(editor, 40), column, `caret paints on the clicked cell of column ${column}`);
+		}
+	});
+
+	it("clicks a right-aligned RTL line at the edge the text is painted on", () => {
+		configureBidi({ enabled: true, align: true });
+		try {
+			const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+			typeInto(editor, "مرحبا");
+			// The run hugs the right edge of the 40-column line, so its cells start at 35.
+			for (const [column, logical] of [
+				[35, 5],
+				[36, 4],
+				[37, 3],
+				[38, 2],
+				[39, 1],
+			]) {
+				click(editor, column, 1, 40);
+				assert.strictEqual(editorState(editor).cursorCol, logical, `click on column ${column}`);
+				assert.strictEqual(caretColumn(editor, 40), column, `caret paints on the clicked cell of column ${column}`);
+			}
+		} finally {
+			configureBidi({ enabled: true, align: false });
+		}
+	});
+
+	it("maps clicks in a line that mixes Latin and Arabic", () => {
+		const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+		typeInto(editor, "hello مرحبا world");
+		// Painted: "hello ابحرم world" - column 6 is the first painted cell of the
+		// Arabic run. The caret goes before that grapheme in logical order; no
+		// boundary can paint at column 6, so it is the nearest one.
+		click(editor, 6, 1, 40);
+		assert.strictEqual(editorState(editor).cursorCol, 10, "caret goes before the clicked ا");
+		for (const [column, logical] of [
+			[7, 10],
+			[8, 9],
+			[9, 8],
+			[10, 7],
+		]) {
+			click(editor, column, 1, 40);
+			assert.strictEqual(editorState(editor).cursorCol, logical, `click on column ${column}`);
+			assert.strictEqual(caretColumn(editor, 40), column, `caret paints on the clicked cell of column ${column}`);
+		}
+		// The Latin part of the line is untouched by the reversal.
+		click(editor, 4, 1, 40);
+		assert.strictEqual(editorState(editor).cursorCol, 4, "caret on the clicked o");
+		click(editor, 13, 1, 40);
+		assert.strictEqual(editorState(editor).cursorCol, 13, "caret on the clicked o of world");
+	});
+
+	it("leaves clicks logical when RTL rendering is off", () => {
+		configureBidi({ enabled: false, align: false });
+		try {
+			const editor = new Editor(createTestTUI(40), defaultEditorTheme);
+			typeInto(editor, "مرحبا");
+			// The line is painted exactly as written, so column and logical index agree.
+			for (let column = 0; column < 5; column++) {
+				click(editor, column, 1, 40);
+				assert.strictEqual(editorState(editor).cursorCol, column, `click on column ${column}`);
+			}
+			assert.strictEqual(
+				caretOffsetAtVisualColumn("مرحبا", 2),
+				undefined,
+				"no visual mapping for an unreordered line",
+			);
+		} finally {
+			configureBidi({ enabled: true, align: false });
+		}
+	});
+});
diff --git a/packages/tui/test/bidi-markdown.test.ts b/packages/tui/test/bidi-markdown.test.ts
new file mode 100644
index 000000000..b4fd14626
--- /dev/null
+++ b/packages/tui/test/bidi-markdown.test.ts
@@ -0,0 +1,196 @@
+import assert from "node:assert";
+import { describe, it } from "node:test";
+import { configureBidi, reorderLine } from "../src/bidi.ts";
+import { Markdown } from "../src/components/markdown.ts";
+import { visibleWidth, wrapTextWithAnsi } from "../src/utils.ts";
+import { defaultMarkdownTheme } from "./test-themes.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+function stripAnsi(line: string): string {
+	return line.replace(/\x1b\[[0-9;]*m/g, "");
+}
+
+function renderMarkdown(markdown: string, width: number): string[] {
+	return new Markdown(markdown, 0, 0, defaultMarkdownTheme).render(width).map((line) => stripAnsi(line).trimEnd());
+}
+
+describe("Arabic in the markdown renderer", () => {
+	it("paints an RTL paragraph in visual order", () => {
+		assert.equal(renderMarkdown("مرحبا بالعالم", 40)[0], "ملاعلاب ابحرم");
+	});
+
+	it("leaves English paragraphs exactly as before", () => {
+		assert.equal(renderMarkdown("hello world", 40)[0], "hello world");
+	});
+
+	it("wraps the logical text, then reorders each visual line", () => {
+		const text = "هذا نص عربي طويل جدا جدا جدا لا يستوعبه العرض";
+		const logicalLines = wrapTextWithAnsi(text, 20);
+		const visualLines = renderMarkdown(text, 20);
+		assert.ok(logicalLines.length > 1, "the paragraph must wrap");
+		assert.equal(visualLines.length, logicalLines.length);
+		for (let i = 0; i < logicalLines.length; i++) {
+			assert.equal(visualLines[i], reorderLine(logicalLines[i]), `line ${i}: ${visualLines[i]}`);
+		}
+	});
+
+	it("keeps code blocks left to right", () => {
+		const lines = renderMarkdown("```python\n# مرحبا\nprint(1)\n```", 40);
+		assert.ok(
+			lines.some((line) => line.includes("مرحبا")),
+			lines.join("\n"),
+		);
+	});
+
+	it("keeps list markers on the left edge", () => {
+		const lines = renderMarkdown("- مرحبا\n- عالم", 40);
+		assert.ok(lines[0].startsWith("- "), lines[0]);
+		assert.ok(lines[1].startsWith("- "), lines[1]);
+	});
+
+	it("keeps the table grid while reordering cell content", () => {
+		const lines = renderMarkdown("| عربي | English |\n|------|---------|\n| مرحبا | hello |", 40);
+		assert.ok(
+			lines.some((line) => line.startsWith("┌─")),
+			lines[0],
+		);
+		const header = lines.find((line) => line.includes("│"))!;
+		// The cell text travels; the column widths and the │ do not.
+		assert.ok(header.includes("يبرع"), header);
+		assert.ok(header.includes("English"), header);
+		assert.equal(visibleWidth(header.replace(/\x1b\[[0-9;]*m/g, "")), visibleWidth(lines[2]), header);
+	});
+
+	it("reorders RTL text inside the borders of a blockquote", () => {
+		const lines = renderMarkdown("> שלום hello\n> این خط فارسی است", 40);
+		assert.ok(lines[0].startsWith("│ "), lines[0]);
+		assert.ok(!lines[0].includes("שלום"), lines[0]);
+		assert.ok(lines[1].startsWith("│ "), lines[1]);
+	});
+
+	it("writes the reordered cells into the terminal buffer", async () => {
+		const terminal = new VirtualTerminal(24, 4);
+		for (const line of new Markdown("مرحبا بالعالم", 1, 0, defaultMarkdownTheme).render(24)) {
+			terminal.write(`${line}\n`);
+		}
+		const viewport = await terminal.flushAndGetViewport();
+		const row = viewport.findIndex((line) => line.trim().length > 0);
+		assert.ok(row >= 0, viewport.join("|"));
+		assert.equal(viewport[row].trim(), "ملاعلاب ابحرم", viewport[row]);
+	});
+
+	it("renders the old way when bidi is switched off", () => {
+		const withBidi = renderMarkdown("مرحبا بالعالم", 40);
+		configureBidi({ enabled: false });
+		const withoutBidi = renderMarkdown("مرحبا بالعالم", 40);
+		configureBidi({ enabled: true });
+		assert.equal(withBidi[0], "ملاعلاب ابحرم");
+		assert.equal(withoutBidi[0], "مرحبا بالعالم");
+	});
+
+	it("keeps the background fill to the right edge of a reordered line", () => {
+		configureBidi({ enabled: true, align: false });
+		const line = new Markdown("مرحبا بالعالم **bold**", 1, 0, defaultMarkdownTheme, {
+			bgColor: (text: string) => `\x1b[44m${text}\x1b[49m`,
+		}).render(30)[0];
+
+		assert.ok(line.includes("ملاعلاب"), line);
+
+		// The background the renderer wraps the line in has to survive the reorder:
+		// a full reset in the middle of the line would leave the padding black.
+		const bgStart = line.indexOf("\x1b[44m");
+		const bgEnd = line.lastIndexOf("\x1b[49m");
+		assert.ok(bgStart >= 0 && bgEnd > bgStart, line);
+		assert.ok(!line.slice(bgStart + 6, bgEnd).includes("\x1b[0m"), line);
+		assert.equal(visibleWidth(line), 30, line);
+	});
+});
+
+describe("alignment follows the script that dominates the line", () => {
+	function renderAligned(markdown: string, width: number): string {
+		configureBidi({ enabled: true, align: true });
+		return new Markdown(markdown, 0, 0, defaultMarkdownTheme).render(width)[0].trimEnd();
+	}
+
+	it("pushes an Arabic line to the right edge", () => {
+		const line = renderAligned("مرحبا بالعالم", 20);
+		assert.equal(stripAnsi(line), "       ملاعلاب ابحرم", line);
+		assert.equal(visibleWidth(line), 20, line);
+	});
+
+	it("leaves an English line at the left edge", () => {
+		const line = renderAligned("hello world", 20);
+		assert.equal(stripAnsi(line), "hello world", line);
+	});
+
+	it("leaves a mixed line with more English than Arabic at the left edge", () => {
+		const line = renderAligned("npm install ثم build the package", 40);
+		assert.ok(line.startsWith("npm install"), line);
+		assert.ok(!line.startsWith(" "), line);
+	});
+
+	it("pushes a mixed line with more Arabic than English to the right edge", () => {
+		const line = renderAligned("مرحبا بالعالم (mixed 1234)", 40);
+		assert.ok(!line.startsWith("npm"), line);
+		assert.ok(visibleWidth(line) === 40, line);
+		assert.ok(stripAnsi(line).startsWith(" "), line);
+	});
+
+	it("never changes the visible width of a wrapped paragraph", () => {
+		configureBidi({ enabled: true, align: true });
+		const lines = new Markdown("مرحبا بالعالم هذا اختبار للنص الطويل الذي ينعطف", 0, 0, defaultMarkdownTheme).render(
+			30,
+		);
+		for (const line of lines) {
+			assert.ok(visibleWidth(line) <= 30, line);
+		}
+		// Every line of the paragraph ends at the same column.
+		assert.ok(
+			lines.every((line) => visibleWidth(line) === 30),
+			lines.map((line) => visibleWidth(line)).join(","),
+		);
+		configureBidi({ enabled: true, align: false });
+	});
+
+	it("puts the marker on the reading edge of an RTL list item", () => {
+		configureBidi({ enabled: true, align: true });
+		const lines = new Markdown("- عنصر قصير\n- عنصر آخر", 0, 0, defaultMarkdownTheme).render(20);
+		assert.ok(stripAnsi(lines[0]).trimEnd().endsWith("-"), lines[0]);
+		assert.ok(!stripAnsi(lines[0]).startsWith("- "), lines[0]);
+		assert.ok(stripAnsi(lines[1]).trimEnd().endsWith("-"), lines[1]);
+		assert.ok(
+			lines.every((line) => visibleWidth(line) === 20),
+			lines.join("|"),
+		);
+
+		// An item whose text is mostly English keeps its marker on the left.
+		const english = new Markdown("- npm install the package now", 0, 0, defaultMarkdownTheme).render(40)[0];
+		assert.ok(stripAnsi(english).startsWith("- "), english);
+		configureBidi({ enabled: true, align: false });
+	});
+
+	it("puts the blockquote bar on the reading edge of an RTL quote", () => {
+		configureBidi({ enabled: true, align: true });
+		const line = new Markdown("> اقتباس عربي", 0, 0, defaultMarkdownTheme).render(20)[0];
+		assert.ok(stripAnsi(line).trimEnd().endsWith("│"), line);
+		assert.equal(visibleWidth(line), 20, line);
+		configureBidi({ enabled: true, align: false });
+	});
+
+	it("mirrors an RTL table's columns and hugs the grid to the right edge", () => {
+		configureBidi({ enabled: true, align: true });
+		const lines = new Markdown("| الأمر | البديل |\n|---|---|\n| grep -r | rg |", 0, 0, defaultMarkdownTheme).render(
+			30,
+		);
+		const grid = lines[0];
+		assert.ok(stripAnsi(grid).startsWith(" "), grid);
+		assert.ok(!stripAnsi(grid).startsWith("┌"), grid);
+		assert.ok(grid.includes("┐"), grid);
+		assert.ok(!grid.includes("┐ "), grid); // the grid ends flush with the column edge
+
+		const header = lines[1];
+		// The logical first column is painted on the right, its content still in visual order.
+		assert.ok(header.indexOf("ليدبلا") < header.indexOf("رمألا"), header);
+		configureBidi({ enabled: true, align: false });
+	});
+});
diff --git a/packages/tui/test/bidi-selection.test.ts b/packages/tui/test/bidi-selection.test.ts
